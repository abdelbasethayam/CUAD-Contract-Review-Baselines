# Example environment for the improved classification pipeline

# Required for embedding (must match the model used to build the Qdrant index)
COHERE_API_KEY=
COHERE_MODEL=embed-english-v3.0

# Local Ollama – prefer a 7B-class Qwen for >66% target
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300

# Retrieval
TOP_K=10
MIN_RETRIEVAL_CONFIDENCE=0.35
QDRANT_PATH=./data/qdrant_local
# or remote:
# QDRANT_URL=
# QDRANT_API_KEY=

# Optional OpenRouter (risk layer / fallback)
# OPENROUTER_API_KEY=
