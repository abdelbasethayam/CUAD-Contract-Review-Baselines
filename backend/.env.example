COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_BATCH_SIZE=96
COHERE_MAX_RETRY_ATTEMPTS=8

QDRANT_PATH=../data/qdrant_local
QDRANT_COLLECTION=cuad_train
LEGAL_KNOWLEDGE_COLLECTION=legal_knowledge
LEGAL_KNOWLEDGE_TOP_K=3
LEGAL_KNOWLEDGE_PATH=backend/data/legal_knowledge

OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL is also supported for compatibility with existing local .env files.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRY_ATTEMPTS=3

TOP_K=5
CONTRACT_CONTEXT_TOP_K=5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_RISK_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRY_ATTEMPTS=3
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=700

# hybrid = Docling when installed, with deterministic segmentation and
# automatic pdfplumber fallback; regex = always use the legacy extractor.
CONTRACT_PARSER=hybrid
