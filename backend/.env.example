# Classifier — prefer Instruct for classification / letter-MCQ
# Primary FT target: Qwen/Qwen2.5-7B-Instruct  →  ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
HF_CLASSIFIER_MODEL=Qwen/Qwen2.5-7B-Instruct
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=8192
CLASSIFIER_TEMPERATURE=0.0

# Optional Thinking model (research only; not primary for FT classification)
# OLLAMA_MODEL=qwen3:4b-thinking-2507
# HF_CLASSIFIER_MODEL=Qwen/Qwen3-4B-Thinking-2507

# Dense retrieval (Cohere)
COHERE_API_KEY=
COHERE_MODEL=embed-english-v3.0
TOP_K=12
MIN_RETRIEVAL_CONFIDENCE=0.32
QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=cuad_train

# Hybrid dense + TF-IDF RRF shortlist
HYBRID_COLLECTION=cuad_train
HYBRID_INDEX_CACHE=./output/cache/hybrid_train_index.npz
HYBRID_K=30
HYBRID_SHORTLIST=8

# Phase 2 risk analysis
RISK_MODEL=qwen3:8b
RISK_NUM_CTX=16384
RISK_TEMPERATURE=0.0
RISK_MAX_TOKENS=1800
RISK_SELF_CONSISTENCY_PASSES=3
RISK_CONTEXT_TOP_K=5
RISK_PLAYBOOK_PATH=./data/risk/commercial_clause_risk_playbook.json
RISK_PLAYBOOK_VERSION=starter-v1

RISK_USE_PLAYBOOK=true
RISK_USE_CONTEXT=true
RISK_USE_LEGAL_GUIDANCE=true
RISK_ENABLE_CROSS_CLAUSE=true
RISK_ENABLE_DOCUMENT_CHECKS=true
