{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cuad-contract-review/rule_registry.schema.json",
  "title": "Phase 2 rule registry record",
  "type": "object",
  "required": [
    "schema_version",
    "rule_id",
    "base_rule_key",
    "base_rule_id",
    "record_kind",
    "contract_type_profile",
    "applicability_status",
    "validation_status",
    "approval_status",
    "execution_status",
    "execution_eligible",
    "legal_conclusion_allowed",
    "source_playbook_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "base_rule_key": {
      "type": "string",
      "minLength": 1
    },
    "base_rule_id": {
      "type": "string",
      "minLength": 1
    },
    "record_kind": {
      "enum": [
        "BASE_RULE",
        "CONTEXT_VARIANT_CANDIDATE"
      ]
    },
    "rule_family": {
      "enum": [
        "CLAUSE_CHECK",
        "CROSS_CLAUSE_CHECK",
        "DOCUMENT_CHECK",
        "DETERMINISTIC_REGEX"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "clause_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_domain": {
      "type": "string",
      "minLength": 1
    },
    "risk_subdomain": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "perspective": {
      "type": "string",
      "minLength": 1
    },
    "contract_type_profile": {
      "type": "string",
      "minLength": 1
    },
    "contract_type_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability_status": {
      "type": "string"
    },
    "jurisdiction_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jurisdiction_status": {
      "enum": [
        "UNRESOLVED",
        "DECLARED_NOT_VERIFIED",
        "VERIFIED"
      ]
    },
    "jurisdiction_review_required": {
      "type": "boolean"
    },
    "decision_logic": {
      "type": "object",
      "required": [
        "question",
        "trigger_condition",
        "counterconditions",
        "dependencies",
        "applies_when",
        "pattern",
        "exclude_patterns"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "trigger_condition": {
          "type": "string"
        },
        "counterconditions": {
          "type": "array"
        },
        "dependencies": {
          "type": "array"
        },
        "applies_when": {
          "type": "array"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclude_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability_hypothesis": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "required_evidence",
        "evidence_location",
        "exact_quote_required",
        "must_be_from_uploaded_contract",
        "source_citation_is_not_contract_evidence",
        "affected_clause_ids_required"
      ],
      "properties": {
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_location": {
          "type": "string"
        },
        "exact_quote_required": {
          "type": "boolean"
        },
        "must_be_from_uploaded_contract": {
          "type": "boolean"
        },
        "source_citation_is_not_contract_evidence": {
          "type": "boolean"
        },
        "affected_clause_ids_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_status": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "severity_rationale": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "NOT_USED"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "confidence_policy": {
      "type": "object",
      "required": [
        "target",
        "raw_support_score_status",
        "probability_allowed_only_when",
        "model_self_reported_confidence_allowed"
      ],
      "properties": {
        "target": {
          "const": "PREDICTION_CORRECTNESS"
        },
        "raw_support_score_status": {
          "const": "HEURISTIC_UNCALIBRATED"
        },
        "probability_allowed_only_when": {
          "type": "string"
        },
        "model_self_reported_confidence_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "review_governance": {
      "type": "object",
      "required": [
        "status",
        "reviewer_ids",
        "reviewer_decisions",
        "adjudicator_id",
        "adjudication_reference",
        "adjudicated_at",
        "approved_by",
        "approved_at",
        "approval_basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_REVIEW",
            "ADJUDICATED",
            "APPROVED",
            "REJECTED"
          ]
        },
        "reviewer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewer_decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "reviewer_id",
              "decision",
              "rationale",
              "reviewed_at"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "POTENTIAL_RISK",
                  "NO_RISK",
                  "INSUFFICIENT_EVIDENCE",
                  "NOT_APPLICABLE"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "adjudicator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudication_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudicated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approval_basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "regression_cases": {
      "type": "object",
      "required": [
        "positive",
        "negative",
        "edge"
      ],
      "properties": {
        "positive": {
          "type": "array"
        },
        "negative": {
          "type": "array"
        },
        "edge": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "validation_status": {
      "enum": [
        "DRAFT_UNVALIDATED",
        "IN_REVIEW",
        "ADJUDICATED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "approval_status": {
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "PILOT_REVIEW_ONLY",
        "DISABLED_UNVALIDATED_CANDIDATE",
        "APPROVED_FOR_EXECUTION"
      ]
    },
    "execution_eligible": {
      "type": "boolean"
    },
    "legal_conclusion_allowed": {
      "const": false
    },
    "source_playbook_hash": {
      "type": "string"
    },
    "candidate_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "inherits_from_base_rule": {
      "type": "string"
    },
    "inherited_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_map": {
      "type": "object",
      "required": [
        "clause_type",
        "authority_ids",
        "authority_sources",
        "authority_coverage_status",
        "scope_note",
        "jurisdiction_policy",
        "review_status"
      ],
      "properties": {
        "clause_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "authority_id",
              "title",
              "citation",
              "source_type",
              "url",
              "pinpoint",
              "jurisdiction",
              "source_tier",
              "authority_status",
              "effective_date",
              "effective_date_status",
              "retrieval_date",
              "verification_status",
              "currentness_status",
              "scope_limit"
            ],
            "properties": {
              "authority_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "citation": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "enum": [
                  "FEDERAL_STATUTE",
                  "STATE_STATUTE",
                  "REGULATOR_STATUS_NOTICE",
                  "PRIMARY_COURT_OPINION_REPUBLISHED"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "pinpoint": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 1
              },
              "source_tier": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "authority_status": {
                "type": "string",
                "minLength": 1
              },
              "effective_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective_date_status": {
                "type": "string",
                "minLength": 1
              },
              "retrieval_date": {
                "type": "string",
                "format": "date"
              },
              "verification_status": {
                "type": "string",
                "minLength": 1
              },
              "currentness_status": {
                "type": "string",
                "minLength": 1
              },
              "scope_limit": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "authority_coverage_status": {
          "enum": [
            "LIMITED_PRIMARY_AUTHORITY_LINKED",
            "NO_UNIVERSAL_PRIMARY_AUTHORITY_IDENTIFIED",
            "RULE_FAMILY_SPECIFIC_AUTHORITY_REVIEW_REQUIRED"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_policy": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "const": "RESEARCH_SEED_NOT_LEGALLY_APPROVED"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "BASE_RULE"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "required": [
          "rule_family",
          "title",
          "risk_domain",
          "perspective",
          "contract_type_scope",
          "jurisdiction_scope",
          "jurisdiction_status",
          "jurisdiction_review_required",
          "decision_logic",
          "evidence_contract",
          "source_ids",
          "source_status",
          "severity_rationale",
          "confidence_policy",
          "regression_cases"
        ],
        "properties": {
          "execution_status": {
            "enum": [
              "PILOT_REVIEW_ONLY",
              "APPROVED_FOR_EXECUTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "CONTEXT_VARIANT_CANDIDATE"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "required": [
          "inherits_from_base_rule",
          "inherited_fields",
          "candidate_note"
        ],
        "properties": {
          "execution_eligible": {
            "const": false
          },
          "execution_status": {
            "const": "DISABLED_UNVALIDATED_CANDIDATE"
          },
          "validation_status": {
            "const": "DRAFT_UNVALIDATED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "BASE_RULE"
          },
          "validation_status": {
            "const": "ADJUDICATED"
          }
        },
        "required": [
          "record_kind",
          "validation_status"
        ]
      },
      "then": {
        "required": [
          "review_governance"
        ],
        "properties": {
          "review_governance": {
            "properties": {
              "status": {
                "const": "ADJUDICATED"
              }
            }
          },
          "execution_status": {
            "const": "PILOT_REVIEW_ONLY"
          },
          "execution_eligible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "BASE_RULE"
          },
          "validation_status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "record_kind",
          "validation_status"
        ]
      },
      "then": {
        "required": [
          "review_governance"
        ],
        "properties": {
          "approval_status": {
            "const": "APPROVED"
          },
          "review_governance": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          },
          "execution_status": {
            "const": "APPROVED_FOR_EXECUTION"
          },
          "execution_eligible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "BASE_RULE"
          },
          "validation_status": {
            "const": "REJECTED"
          }
        },
        "required": [
          "record_kind",
          "validation_status"
        ]
      },
      "then": {
        "properties": {
          "execution_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "BASE_RULE"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "required": [
          "authority_map"
        ]
      }
    }
  ],
  "additionalProperties": true
}
