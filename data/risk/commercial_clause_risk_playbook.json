  "sources": {
    "P1": {
      "id": "P1",
      "citation": "World Commerce & Contracting (WorldCC). Most Negotiated Terms reports (e.g. 2024): limitation of liability, price, indemnification, termination, and intellectual property rank among the most negotiated commercial terms.",
      "url": "https://www.worldcc.com/"
    },
    "P2": {
      "id": "P2",
      "citation": "Thomson Reuters Practical Law and similar commercial practice notes on limitation of liability, indemnification, and risk allocation in business-to-business contracts.",
      "url": null
    },
    "P3": {
      "id": "P3",
      "citation": "Common commercial and SaaS market practice: general liability caps often anchored to fees over a prior period (frequently 12 months); carve-outs commonly include IP indemnity, confidentiality/data, fraud, willful misconduct, and gross negligence.",
      "url": null,
      "note": "Market practice benchmark, not statute."
    },
    "P4": {
      "id": "P4",
      "citation": "Kenneth A. Adams, A Manual of Style for Contract Drafting (ABA Business Law Section).",
      "url": null
    },
    "P5": {
      "id": "P5",
      "citation": "Tina L. Stark, Drafting Contracts: How and Why Lawyers Do What They Do, and related commercial boilerplate / transactional drafting practice.",
      "url": null
    },
    "P6": {
      "id": "P6",
      "citation": "Helena Haapio & George J. Siedel, A Short Guide to Contract Risk.",
      "url": null
    },
    "P7": {
      "id": "P7",
      "citation": "General commercial doctrine notes: liquidated damages versus penalties; public-policy limits on excluding liability for fraud or willful misconduct (jurisdiction-sensitive).",
      "url": null
    }
  },
